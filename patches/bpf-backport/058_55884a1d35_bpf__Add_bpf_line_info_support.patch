 				   const union bpf_attr *attr,
 				   union bpf_attr __user *uattr)
@@ -2017,12 +2047,18 @@ static int bpf_prog_get_info_by_fd(struct bpf_prog *prog,
 				return -EFAULT;
 	}
 
