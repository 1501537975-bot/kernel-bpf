 				   const union bpf_attr *attr,
 				   union bpf_attr __user *uattr)
@@ -1932,18 +1993,33 @@ static int bpf_prog_get_info_by_fd(struct bpf_prog *prog,
 	ulen = info.jited_prog_len;
