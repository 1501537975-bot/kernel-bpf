From: 1e843d5a50f608af56846d446503647c2b2d2713
Subject: [PATCH] bpf: btf: fix truncated last_member_type_id in btf_struct_resolve

上游 backport, 来自 mt6873-dev/android_kernel_xiaomi_mt6885@cgroup-v2
原提交日期: 2022-09-10T11:01:20Z

原提交: https://github.com/mt6873-dev/android_kernel_xiaomi_mt6885/commit/1e843d5a50f608af56846d446503647c2b2d2713

---
diff --git a/kernel/bpf/btf.c b/kernel/bpf/btf.c
--- a/kernel/bpf/btf.c
+++ b/kernel/bpf/btf.c
@@ -1547,7 +1547,7 @@ static int btf_struct_resolve(struct btf_verifier_env *env,
 	if (v->next_member) {
 		const struct btf_type *last_member_type;
 		const struct btf_member *last_member;
-		u16 last_member_type_id;
+		u32 last_member_type_id;
 
 		last_member = btf_type_member(v->t) + v->next_member - 1;
 		last_member_type_id = last_member->type;