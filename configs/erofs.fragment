# EROFS config 片段
# 用于 Android 15+ 的 erofs 系统分区（主线 4.19 才引入，4.14 需 backport）

CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y

# EROFS 依赖的压缩/加密支持
CONFIG_LZ4=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# ZSTD（部分厂商分区用）
CONFIG_ZSTD=y
CONFIG_ZSTD_DECOMPRESS=y

# BPF / BTF（A16+ 必需）
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_PAHOLE_VERSION=y
CONFIG_GDB=y

# Cgroup v2 / freezer（A16+ 常用，freezer 需要）
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_MEMCG=y

# 4.14 已有，但 A16 的 netd 会用
CONFIG_FHANDLE=y
CONFIG_INDIRECT_FD=y
CONFIG_MEMBARRIER=y

# uname 伪装开关（scripts/patch_uname.sh 注入）
CONFIG_FAKE_UNAME=y
